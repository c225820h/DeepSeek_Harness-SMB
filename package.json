{
  "name": "dsh-smb-picker",
  "version": "0.1.0",
  "description": "Pick images straight off an SMB/CIFS share into the DSH composer: browse shares on the Host, attach chosen files without downloading them to the phone first.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "smb",
    "cifs",
    "nas",
    "attachment"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "smb3-client": "^0.2.0"
  },
  "license": "MIT"
}
